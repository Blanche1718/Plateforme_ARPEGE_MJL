};

const registerOrg = async (req, res) => {
    console.log("In registreering: ", req.body);
    try {
        let t = await db.sequelize.transaction(); // Start transaction
        let { email, password, password_confirmation, secret, type } = req.body;

        // Simple validation for demonstration
        if (!email || !password  || !password_confirmation  || !secret || !type) {
            return res.status(400).json({ status: 'failure', message: 'Tous les champs sont requis.' });
        }
        let Model = null;
        if(type == "login-code"){
            Model = db.LoginCode;
        }else if(type == "otp-code"){
            Model = db.CodeOTP;
        }else{
            return res.status(400).json({ status: "failure", message: "Le type n'est pas correct" })
        }

        let codeExist = await Model.findOne({
            where: {
                email,
                secret
            }
        });
    
        if(!codeExist)  return res.status(400).json({status: "failure", message: "Le code a expiré ou n'existe pas."})

        let organisation = await  db.Organisation.findOne({
            where: {
                email,
                disabled: false
            }
        })

        if(!organisation)  return res.status(400).json({status: "failure", message: "L'organisation n'existe pas"})

        const role = await db.Role.findOne({ 
            where: {
                id:  3
            }
        }, { transaction: t });
        
        console.log("Verifying Password");
        if(password != password_confirmation) return res.status(400).json({ status: "failure", message: "Mot de passe pas confirmé" })
        console.log("Verifying Mail domain");
        //if(!utils.isGouvBjEmail(email)) return res.status(400).send("Email doit être '*.gouv.bj'")
  
        console.log("Getting userCentre");
        let user = await User.findOne({ where: {
                [Op.and]:     [
                    { email: email }
                ]
            }
        });
        console.log("role.label", role.label);
        //console.log(centreID,user.id, user.email, user.centreID);
        if(user){
            console.log('Mail déjà pris ou ...')
            return res.status(400).json({status: "failure", message: "Organisation a déjà un compte"});
        }

        
        const saltPass = await bcrypt.genSalt(12);
        const hashPwd = await bcrypt.hash(password,saltPass)
        //console.log(hashPwd)
        User.create({
            nom: organisation.name,
            prenoms: organisation.name,
            email: email,
            password: hashPwd,
            tel: organisation.telephone,
            first_connect: false
        }).then(async (user) =>{
            console.log('user created');
            await user.setRole(role);
            await role.addUsers(user)
            console.log('Association with role setted');

            if(organisation != null){
                console.log('Setting organisation');
                await user.setOrganisation(organisation);
            }

            console.log('Association with role setted');

            const result = await loginLogic(email, password);

            if (result.status === "success") {
                await Model.destroy({
                    where: {
                        id: codeExist.id // Use where to specify the condition
                    }
                });
                return res.status(200).json(result);
            } else {
                return res.status(result.status === "failure" ? 400 : 500).json(result);
            }
        }).catch((error) => {
            console.log(error)
            res.status(500).json({status: "failure", message: "Un problème interne. Veuillez patienter."});
        })
    } catch (error) {
            console.log('Error while processing user: '+error)
            res.status(500).json({status: "failure", message: "Un problème interne. Veuillez patienter."});
    }
    
};



