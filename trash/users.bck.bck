const send_otp = async (req, res) => {
    try {
        const email = req.body.email;

        // Vérifier si l'email de l'organisation existe
        const organization = await db.Organisation.findOne({
            where: { email },
            include: {
                model: db.Status,
                as: 'statutIn',
                required: true,
                where: {
                    libelle: 'valide'
                }
            }
        });

        if (!organization) {
            return res.status(404).json({
                status: 'failure',
                message: 'L\'organisation avec cet email n\'existe pas ou n\'est pas validée. Veuillez contacter la DRIPS ou lesupport au support@justice.bj'
            });
        }

        // Générer et stocker le code OTP
        const otpCode = await utils.generateAndStoreOTP(email); // Assume this function generates and stores the OTP code

        const params = {
            otp: otpCode
        }
        const type = "sendOtpCode";
        const mailOptions = {
            to: organization.email,
            subject: "Code de connexion"
        }
        sendEmail(mailOptions, params, type);
        return res.status(200).json({
            status: 'success',
            message: 'Un code OTP a été envoyé à votre email.'
        });
    } catch (error) {
        console.error('Erreur lors de l\'envoi du code OTP:', error);
        return res.status(500).json({
            status: 'failure',
            message: 'Une erreur est survenue lors du traitement de votre demande.'
        });
    }
};


