const viewUser = (req, res) => {
    // Requête d'un utilisateur par son identifiant avec inclusion de la relation "Role"
    let id = req.params.id;
    User.findOne({
        attributes: [
            'id', 'nom', 'prenoms', 'email', 'tel', 'derniere_connexion',
            [Sequelize.literal('CASE WHEN "disabled" = true THEN \'Bloqué\' ELSE \'Actif\' END'), 'status']
        ],
        where: { id: id },
        include: [
            {
                model: Role,
                as: 'role'
            }
        ]
    }).then(user => {
        if (!user) {
            return res.status(404).json({ status: "failure", message: "Veuillez envoyer un bon utilisateur." });  
        }
        return res.status(200).json({ status: "success", user });
    }).catch(error => {
        console.error(error);
        return res.status(500).json({ status: "failure", message: "Un problème lors de la récupération de l'utilisateur." });  
    });
};

// Fonction pour convertir une image en Base64
const convertImageToBase64 = (imagePath) => {
    console.log('In image converting: ', imagePath);
    try {
        const imageBuffer = fs.readFileSync(imagePath);
        const base64Image = imageBuffer.toString('base64');
        return base64Image;
    } catch (error) {
        console.error('Erreur lors de la conversion de l\'image en Base64 :', error);
        return null;
    }
};

const updateProfileInfo = async (req, res) => {
    console.log("req.params.id: ", req.params.id);
   
    if (!req.body) {
        return res.status(400).json({ status: "failure", message: "Aucune donnée fournie." });
    }

    const bodyIsOk = await bodyCheck.updateProfileBodyCheck(req.body);
    if (!bodyIsOk) {
        return res.status(400).json({ status: "failure", message: "Mauvaise requête." });
    }

    let user = await User.findOne({ where: { id: req.params.id, disabled: false } });
    if (!user) {
        return res.status(404).json({ status: "failure", message: "Utilisateur inconnu." });
    }

    const selector = { where: { id: req.params.id } };

    User.update(req.body, selector).then(async (isUpdated) => {
        if (isUpdated[0] !== 0) { 
            console.log("Converting...");
            var file = req.file;
            if (file) {
                console.log("Saving...");
                const signature = convertImageToBase64(file.path);
                user.signature = signature;
                await user.save(); // Await the save operation
            }
            return res.status(200).json({ status: "success", id: req.params.id });
        } else {
            return res.status(422).json({ status: "failure", message: "Pas d'utilisateur modifié." });
        } 
    }).catch(error => {
        console.error(error);
        return res.status(500).json({ status: "failure", message: "Erreur serveur." });
    });
}

const updateUserByAdmin = async (req, res) => {
    const bodyIsOk = await bodyCheck.updateProfileBodyCheck(req.body);
    if (!bodyIsOk) {
        return res.status(400).json({ status: "failure", message: "Mauvaise requête." });
    }

    let user = await User.findOne({
        where: { id: req.params.id }
    });
    if (!user) {
        return res.status(404).json({ status: "failure", message: "Utilisateur inconnu." });
    }
    
    const selector = { where: { id: req.params.id } };

    User.update(req.body, selector).then(isUpdated => {
        if (isUpdated[0] !== 0) {
            return res.status(200).json({ status: "success", id: req.params.id });
        } else {
            return res.status(422).json({ status: "failure", message: "Utilisateur inconnu." });
        } 
    }).catch(error => {
        console.error(error);
        return res.status(500).json({ status: "failure", message: "Erreur serveur." });
    });
}

const restoreUserPassword = async (req, res) => {
    // const bodyIsOk = await bodyCheck.restorePasswordBodyCheck(req.body);
    
    // if (!bodyIsOk) {
    //     return res.status(400).json({ status: "failure", message: "Envoyez tous les champs." }); 
    // }

    try {
        const { id, email } = req.body;
        const default_password = "EBNL@2025";
        let user = await User.findOne({ 
            where: { id, email }
        });

        if (!user) {
            return res.status(400).json({ status: "failure", message: "Email invalide." });
        } 

        const saltPass = await bcrypt.genSalt(12);
        const hashPwd = await bcrypt.hash(default_password, saltPass);
        
        user.password = hashPwd;
        user.first_connect = true;

        const saveResult = await user.save();
        if (!saveResult) {
            return res.status(500).json({ status: "failure", message: "Un problème lors de la mise à jour. Veuillez réessayer." });
        }

        return res.status(200).json({ status: "success", id: user.id, email: user.email });
    } catch (error) {
        console.error(error); // Log the error for debugging
        return res.status(500).json({ status: "failure", message: "Un problème lors de la mise à jour. Veuillez réessayer." });
    }
};

