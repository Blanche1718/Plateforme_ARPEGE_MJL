const db = require("../models/index");
const bodyCheck = require('../helpers/bodyCheck')
const fs = require('fs');
const bcrypt = require('bcryptjs');
const sendEmail = require("../helpers/sendEmail");
const imgConvert = require('../helpers/image-convert');
const utils = require('../helpers/utils');
const { Op, Sequelize } = require('sequelize');
const path = require('path');
const User = db.User;
const Role = db.Role;
const ValidToken = db.ValidToken;

const projectRoot = path.resolve(__dirname, '../');

const registerUser = async (req, res) => {
    console.log("In registering: ", req.body);
    let transaction = null;
    try {
        transaction = await db.sequelize.transaction(); // Start transaction
        const bodyIsOk = await bodyCheck.registerBodyCheck(req.body);
        console.log("bodyIsOk:", bodyIsOk, req.body);
        if (!bodyIsOk) {
            return res.status(400).json({ status: "failure", message: "Vérifiez vos champs et réessayez." });
        };

        let {nom, prenoms, email, password, password_confirmation, telephone, roleID } = req.body;
        console.log(nom, prenoms, email, password, password_confirmation, telephone, roleID);

        let organisationId = req.body.organisationId ? req.body.organisationId : null;
        let organisation = null;

        if (roleID == 3 && organisationId != null) {
            organisation = await db.Organisation.findOne({ where: { id: organisationId }, transaction });
        }
        if (roleID == 3 && !organisation) {
            return res.status(400).json({ status: "failure", message: "Pas d'organisation." });
        }

        console.log("Verifying Password");
        // if (password !== password_confirmation) {
        //     return res.status(400).json({ status: "failure", message: "Mot de passe pas confirmé" });
        // }
        if(!password) password = "EBNL@2025";
        let role = await Role.findOne({ where: { id: roleID }, transaction });
        console.log("Verifying the role");

        let user = await User.findOne({ where: { email: email }, transaction });
        if (user) {
            console.log('Mail déjà pris ou ...');
            return res.status(400).json({ status: "failure", message: "Mail déjà pris" });
        }

        const saltPass = await bcrypt.genSalt(12);
        const hashPwd = await bcrypt.hash(password, saltPass);

        const newUser = await User.create({
            nom: nom,
            prenoms: prenoms,
            email: email,
            password: hashPwd,
            tel: telephone
        }, { transaction });

        console.log('User created');
        await newUser.setRole(role, { transaction });
        await role.addUsers(newUser, { transaction });
        console.log('Association with role set');

        if (organisationId != null) {
            console.log('Setting organisation');
            await newUser.setOrganisation(organisation, { transaction });
        }

        // Sending email
        const params = {
            name: newUser.prenoms + ' ' + newUser.nom,
            username: newUser.email,
            password: password,
            url: process.env.APP_URL + '/login'
        };
        const mailOptions = {
            to: newUser.email,
            subject: "Finalisation de l'inscription"
        };
        await sendEmail(mailOptions, params, "register");

        await transaction.commit(); // Commit transaction
        console.log('Transaction completed successfully.');

        return res.status(200).json({ status: "success", id: newUser.id, user: newUser });
        
    } catch (error) {
        console.error('Error while processing user: ', error);
        await transaction.rollback(); // Rollback transaction on error
        return res.status(500).json({ status: "failure", message: "Un problème interne. Veuillez patienter." });
    }
};

const loginLogic = async (email, password) => {
    try {
        console.log("Getting User: ", email);
        let user = await User.findOne({
            where: {
                email: email,
                disabled: false
            },
            include: [
                {
                    model: Role,
                    as: 'role'
                },
                {
                    model: db.Organisation,
                    as: 'organisation'
                }
            ]
        });

        if (!user) {
            return { status: "failure", message: "Nom d'utilisateur incorrect ou utilisateur désactivé." };
        }

        const nb_con = await ValidToken.count({
            include: {
                model: User,
                as: 'tokenUser',
                where: {
                    id: user.id
                }
            }
        });
        console.log('Connexion: n', nb_con);
        if (nb_con > 100) {
            return { status: "failure", message: "Vous avez beaucoup de comptes actifs, déconnectez-vous de l'un." };
        }

        const isMatch = await bcrypt.compare(password, user.password);
        if (!isMatch) {
            return { status: "failure", message: "Nom d'utilisateur ou mot de passe incorrect." };
        }

        console.log(user.id);
        const jwtToken = utils.signToken(user.id);
        const refreshToken = utils.signRefreshToken(user.id);
        if (jwtToken != 0) {
            user.derniere_connexion = new Date();
            const validToken = await ValidToken.create({
                token: jwtToken
            });
            if (!validToken) {
                return { status: "failure", message: "Un problème interne. Veuillez patienter." };
            }

            await validToken.setTokenUser(user);
            await user.addTokens(validToken);

            if (!await user.save()) {
                return { status: "failure", message: "Un problème interne. Veuillez patienter." };
            }

            let status = utils.getStatus(user);
            let userToSend = {
                refreshToken: refreshToken,
                user: {
                    id: user.id,
                    nom: user.nom,
                    prenoms: user.prenoms,
                    email: user.email,
                    tel: user.tel,
                    first_connect: user.first_connect,
                    derniere_connexion: user.derniere_connexion,
                    status: status,
                    role: user.role.label,
                    organisation: user.organisation
                }
            };

            console.log('Before returning');
            return { status: "success", token: jwtToken, userToSend };
        }

        return { status: "failure", message: "Une erreur s'est produite." };
    } catch (error) {
        console.log(error);
        return { status: "failure", message: "Un problème interne. Veuillez patienter." };
    }
};

const login = async (req, res) => {
    console.log("IN login");
    const bodyIsOk = await bodyCheck.loginBodyCheck(req.body);
    if (!bodyIsOk) {
        return res.status(400).json({ status: "failure", message: "Veuillez remplir tous les champs." });
    }

    const { email, password } = req.body;
    const result = await loginLogic(email, password);

    if (result.status === "success") {
        return res.status(200).json(result);
    } else {
        return res.status(result.status === "failure" ? 400 : 500).json(result);
    }
};

const handleToken = async (req, res) => {
    const jwtToken = req.body.jwtToken; // Token d'accès extrait des cookies
    const refreshTokenStored = req.body.refreshToken; // Refresh token extrait des cookies

    console.log("Token d'accès extrait :", jwtToken);
    console.log("Refresh token extrait :", refreshTokenStored);

    // Vérifie si le token d'accès expire bientôt
    if (await utils.isTokenExpiringSoon(jwtToken)) {
        console.log("Le token d'accès expire bientôt, demande de nouveau token...");

        // Si oui, demande un nouveau token en utilisant le refresh token
        const newTokens = utils.refreshToken(refreshTokenStored);
        console.log('New Refresh Token: ', newTokens)
        if (newTokens) {
            console.log("Nouveaux tokens reçus :", newTokens);

            // Mets à jour les tokens dans les cookies
            // res.cookie('jwtToken', newTokens.accessToken, { httpOnly: true, secure: false, maxAge: 3600000, sameSite: 'Lax', path: '/' });
            // res.cookie('refreshToken', newTokens.refreshToken, { httpOnly: true, secure: false, maxAge: 604800000, sameSite: 'Lax', path: '/' }); // 7 jours

            // Répondre au client avec un statut de succès
            console.log("Tokens mis à jour dans les cookies.");
            return res.status(200).json({
                status: "success",
                message: 'Tokens rafraîchis avec succès',
                accessToken: newTokens.accessToken,
                refreshToken: newTokens.refreshToken
            });
        } else {
            console.log('Le refresh token est expiré ou invalide. L’utilisateur doit se reconnecter.');
            return res.status(401).json({
                status: "failure",
                message: 'Session expirée, veuillez vous reconnecter.'
            });
        }
    }

    console.log("Le token d'accès est encore valide, aucune action requise.");
    return res.status(200).json({
        status: "success",
        message: 'Le token est valide',
        accessToken: jwtToken
    });
}

const updateProfilePassword = async (req, res) => {
    //requête d'un utilisateur par son identifiant avec inclusion de la relation "Role"
    const bodyIsOk = await bodyCheck.updateProfilePasswordBodyCheck(req.body);
    //console.log("bodyisOk:",bodyIsOk)
    if (!bodyIsOk) {
        res.status(400).json({status: "failure", message: "Remplissez tous les champs correctement"});
    }
    const {email, apassword, password, password_confirmation } = req.body;
    if(password != password_confirmation) return res.status(400).json({status: "failure", message: "Username ou mot de passe incorrects"});
    
    try {
        let user = await User.findOne({ 
            where: {email: email},
            include: {
                model: db.Role, 
                as: 'role', 
                where: {
                    libelle: { [Sequelize.Op.ne]: 'admin' }
                }
            }
        });
        if (!user) {
            return res.status(400).json({status: "failure", message: "Email incorrect"});
        } 
        
        const isMatch = await bcrypt.compare(apassword, user.password)
        if(!isMatch){
            return res.status(400).json({status: "failure", message: "Ancien mot de passe invalide"});
        }
        

        const saltPass = await bcrypt.genSalt(12);
        const hashPwd = await bcrypt.hash(password,saltPass)
        
        user.password = hashPwd;
        if (user.first_connect == true) user.first_connect = false;
        if(!user.save()) res.status(500).json({status: "failure", message: "Un problème lors de la mise à jour. Veuillez réessayer."});  
        
        return res.status(200).json({status: "success", id: user.id});
    } catch (error) {
        console.log("Error: ", error)
        return res.status(500).json({status: "failure", message: "success"});  
    }
}   


const disableUser = async (req, res) => {
    try {
        console.log("ID: ", req.body.id)
        let id = req.body.id;
        let user = await User.findByPk(id, {
            where: {
                disabled: false
            },
            include: {
                model: db.Role, 
                as: 'role', 
                where: {
                    libelle: { [Sequelize.Op.ne]: 'admin' }
                }
            }
        });
        if (user) {
            user.disabled = true;
            const saveResult = await user.save();
            if (!saveResult) {
                return res.status(500).json({ status: "failure", message: 'Erreur serveur: Impossible de désactiver l\'utilisateur.' });
            }
            return res.status(200).json({ status: "success", id: id });
        } else {
            return res.status(422).json({ status: "failure", message: "Utilisateur inconnu." });
        }   
    } catch (error) {
        console.error(error);
        return res.status(500).json({ status: "failure", message: "Erreur serveur." });
    }
}

const ableUser = async (req, res) => {
    let id = req.body.id;
