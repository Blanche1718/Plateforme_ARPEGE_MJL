    }
}

const logout = async (req, res) => {
    console.log('In logout');
    console.log(req.userId);
    
    try {
        const valid = await ValidToken.findOne({
            where: {
                userID: req.userId,
                token: req.token
            }
        });

        if (valid) {
            console.log('ValidToken found');
            try {
                await valid.destroy();
                console.log('ValidToken successfully deleted');
                return res.status(200).json({ status: "success", message: "Déconnexion réussie." });
            } catch (error) {
                console.error('Error deleting ValidToken:', error);
                return res.status(405).json({ status: "failure", message: "Veuillez réessayer." });  
            }
        } else {
            console.log('ValidToken not found for the given criteria');
            return res.status(405).json({ status: "failure", message: "Veuillez vous connecter." });  
        }
    } catch (err) {
        console.error(err);
        return res.status(405).json({ status: "failure", message: "Un problème lors de la déconnexion. Veuillez réessayer." });  
    }
}

const viewAllUsers = (req, res) => { 
    User.findAll({
        where: {
            disabled: false
        },
        attributes: [
            'id', 'nom', 'prenoms', 'email', 'tel', 'derniere_connexion',
            [Sequelize.literal('CASE WHEN "disabled" = true THEN \'Bloqué\' ELSE \'Actif\' END'), 'status']
        ],
        include: [
            {
                model: db.Role,
                as: 'role'
            }
        ],
    }).then(users => { 
        console.log(users);
        return res.status(200).json({ status: "success", users });
    }).catch(function (error) { 
        console.error(error);
        return res.status(500).json({ status: "failure", message: "Un problème lors de la récupération des utilisateurs." });  
    });
};


