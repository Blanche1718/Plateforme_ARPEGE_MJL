                }}</p>
            <p><span class="label underlined">Situation militaire :</span> {{ military_status }}</p>
            <p><span class="label underlined">Classe de recrutement :</span> {{ recrut_class }}</p>
        </div>
        
        
        <div class="bracket-container-scalable">
