    <script>

        var imgUrlData = {
            cachet: "data:image/png;base64,"
        };
        document.addEventListener('DOMContentLoaded', () => {
            const MAX_HEIGHT = 1000; 
            let processing = false;

            const getHeight = (el) => el.scrollHeight +
                parseFloat(getComputedStyle(el).marginTop || 0) +
                parseFloat(getComputedStyle(el).marginBottom || 0);

            const getPageHeight = (page) =>
                [...page.children].reduce((h, child) =>
                    child.classList.contains('footer') ? h : h + getHeight(child), 0);

            const createPage = () => {
                const page = document.createElement('div');
                page.className = 'page';
                page.style.pageBreakAfter = 'always';

                const footer = document.createElement('div');
                footer.className = 'footer';
                Object.assign(footer.style, {
                    position: 'absolute',
                    bottom: '20px',
                    left: '50%',
                    transform: 'translateX(-50%)'
                });
                page.appendChild(footer);
                return page;
            };

            const paginate = () => {
                if (processing) return;
                processing = true;

                const pages = [...document.querySelectorAll('.page')];

                pages.forEach((page, i) => {
                    const content = [...page.querySelectorAll('.section, .sections, .promotions-grid')];
                    if (!content.length || getPageHeight(page) <= MAX_HEIGHT) return;

                    let height = getPageHeight(page) - content.reduce((h, el) => h + getHeight(el), 0);
                    const keep = [], move = [];

                    for (const el of content) {
                        const elHeight = getHeight(el);
                        if (height + elHeight <= MAX_HEIGHT) {
                            keep.push(el);
                            height += elHeight;
                        } else {
                            move.push(...content.slice(content.indexOf(el)));
                            break;
                        }
                    }

                    if (move.length) {
                        let nextPage = pages[i + 1];
                        if (!nextPage) {
                            nextPage = createPage();
                            page.after(nextPage);
                        }

                        move.forEach(el => {
                            const clone = el.cloneNode(true);
                            const footer = nextPage.querySelector('.footer');
                            nextPage.insertBefore(clone, footer);
                            el.remove();
                        });
                    }
                });

                document.querySelectorAll('.page').forEach((page, i) => {
                    const hasContent = page.querySelectorAll('.section, .sections, .promotions-grid').length ||
                        page.querySelector('img, #qrcode') ||
                        page.textContent.replace(/Page \d+/g, '').trim().length > 20;

                    if (!hasContent) {
                        page.remove();
                    } else {
                        const footer = page.querySelector('.footer');
                        if (footer && !footer.textContent.includes('Page')) {
                            footer.textContent += ` Page ${i + 1}`;
                        }
                    }
                });

                processing = false;
            };

            setTimeout(paginate, 500);

            new MutationObserver(mutations => {
                if (mutations.some(m => m.type === 'childList' &&
                    [...m.addedNodes].some(n => n.classList?.contains?.('section') ||
                        n.classList?.contains?.('sections') ||
                        n.classList?.contains?.('promotions-grid')))) {
                    setTimeout(paginate, 300);
                }
            }).observe(document.body, { childList: true, subtree: true });
        });
        
        
        
