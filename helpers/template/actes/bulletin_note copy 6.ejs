                <ul>
                    <!-- {{#each honorary_distinction}}
                    <li>{{ this.label }}</li>
                    {{/each}} -->
                                        Système Informtique et Logiciel

                </ul>
            </div>
        </div>
        <div>
            <p>Date et lieu de Mariage : <span class="label">{{ date_of_marriage }} à {{ place_of_marriage }}</span></p>
            <p>Nom et date de naissance des enfants vivants :</p>
            <ul>
                {{#each children}}
