                    <div class="criteria">2/ Conscience professionnelle ..................... /7</div>
                    <div class="criteria">3/ Sens du service public .......................... /6</div>
                    <div class="total">TOTAL .......................................... /20</div>
                    <div class="dates">A {{ evaluation_2_place }}, le {{ evaluation_2_date }}</div>
