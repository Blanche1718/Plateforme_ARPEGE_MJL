        /*bracket*/
        function updateScalableBracket() {
            const container = document.getElementById('competences-scale');
            const bracket = document.getElementById('bracket-scale');

            const containerHeight = container.offsetHeight;
            const baseBracketHeight = 65;

            const scaleFactor = Math.max(1, containerHeight / baseBracketHeight);

            bracket.style.transform = `translate(-50%, -50%) scaleY(${scaleFactor})`;
        }

        let resizeObserver;

        function initializeObserver() {
            if (resizeObserver) {
                resizeObserver.disconnect();
            }

            resizeObserver = new ResizeObserver((entries) => {
                updateScalableBracket();
            });

            const container = document.getElementById('competences-scale');
            if (container) {
                resizeObserver.observe(container);
            }
        }

        window.addEventListener('load', () => {
            initializeObserver();
            updateScalableBracket();
        });

        function updateScalableBracket() {
            const container = document.getElementById('competences-scale');
            const bracket = document.getElementById('bracket-scale');

            const containerHeight = container.offsetHeight;
            const baseBracketHeight = 65;

            const scaleFactor = Math.max(1, containerHeight / baseBracketHeight);

            const scaleXCompensation = Math.max(0.7, 1 / Math.sqrt(scaleFactor));

            bracket.style.transform = `translate(0, -50%) scale(${scaleXCompensation}, ${scaleFactor})`;
        }

