                    {{/each}}
                </div>
                 
            </div>
        </div>

        <div>
            <p>Date de nomination : <span class="label">{{ date_of_service }}</span></p>
            <p>Régime de pensions : <span class="label">{{ pension_scheme }}</span></p>
            <p>Grade actuel : <span class="label">{{ actual_grade_class }}</span></p>
            <p>Date de promotion : <span class="label">{{ date_of_promotion }}</span></p>
        </div>
        
        <div class="bracket-container-scalable">
            <h3>Interruption de service :</h3>
            <div class="bracket-scalable" id="bracket-scales">{</div>
            <div class="lines-scalable" id="competences-scales">
                <div class="lines">
                    {{#each services_interruptions}}
