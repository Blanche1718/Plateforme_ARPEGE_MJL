<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <title>Bulletin Individuel de Notes</title>
    <style>
        @media print {
            body {
                font-family: 'Arial', sans-serif !important;
                font-size: 10pt !important;
            }

            @page {
                size: A4;
                margin: 10mm;
            }

            .page {
                min-height: 297mm;
                padding: 5mm;
                box-sizing: border-box;
                page-break-after: always;
                page-break-inside: avoid;
                padding-left: 5mm;
                padding-right: 5mm;
            }

            .page:last-child {
                page-break-after: avoid;
            }

            .page:empty {
                display: none;
            }

            .footer {
                position: absolute;
                bottom: 10mm;
                right: 10mm;
                font-size: 10pt;
                color: #666;
            }
        }

        @media screen {
            .page {
                width: 210mm;
                min-height: 297mm;
                margin: 1rem auto;
                padding: 15mm;
                background: white;
                page-break-after: always;
            }

            .page:last-child {
                page-break-after: auto;
            }

            .page:hover {
                box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
            }
        }

        body {
            font-size: 10pt;
            line-height: 1.7;
            margin: 0;
            padding: 0;
            counter-reset: page;
        }

        .container {
            max-width: 210mm;
            margin: 0 auto;
        }

        .header {
            margin-bottom: 25px;
            position: relative; 
            display: flex;
            flex-direction: column;
            align-items: flex-start;
        }

        .header p {
            margin: 4px 0;
        }

        h1,
        h2,
        h3 {
            text-align: center;
            margin: 15px 0;
        }

        .section,
        .sections {
            margin: 10px;
            page-break-inside: avoid;
            break-inside: avoid;
        }

        .sections {
            border-bottom: 2px solid black;
            padding-bottom: 5px;
        }

        .label {
            font-weight: bold;
            margin-right: 8px;
        }

        .underlined {
            display: inline-block;
            text-decoration: underline;
            text-underline-offset: 2px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
        }

        td,
        th {
            border: 1px solid #000;
            padding: 4px;
            text-align: left;
            vertical-align: top;
        }

        th {
            font-weight: bold;
            text-align: center;
            background-color: #f9f9f9;
        }

        tbody td {
            padding: 4px;
        }

        tbody tr:last-child td {
            font-weight: bold;
        }

        tbody td:nth-child(2),
        tbody td:nth-child(3),
        tbody td:nth-child(4) {
            text-align: center;
            font-weight: normal;
        }

        .center {
            text-align: center;
        }

        .bracket {
            font-size: 65px;
            line-height: 1;
            margin-right: 12px;
        }

        .bracket-container {
            display: flex;
            align-items: flex-start;
            margin: 15px 0;
        }
        .diplome-item {
            margin: 4px 0;
            line-height: 1.6;
        }
       
        .colonne-title {
            width: 80%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            text-align: center;
            align-items: center;
        }

        .colonne-title * {
            margin: 5px 0;
        }

        .colonne-title .hr {
            height: 3px;
            width: 35%;
            background-color: #000;
        }

        .promotions-grid {
            display: flex;
            /* gap: 40px; */
            margin: auto;
            margin-top: 20px;
            justify-content: space-between;
        }

        .promo-column {
            width: 48%;
        }

        .promo-column h3 {
            margin-bottom: 10px;
        }

        .promo-column p {
            line-height: 1.6;
            margin-bottom: 8px;
            word-break: break-all;
            overflow-wrap: break-word;
            text-align: justify;
        }

        .section-directeur {
            display: flex;
            flex-direction: row;
            justify-content: space-between;
            align-items: flex-start;
            margin: 20px 0;
            line-height: 1.5;
        }
        .note-directeur-container * {
            font-size: 10pt;
        }

        .ligne {
            border-bottom: 3px solid #000;
            width: 150px;
            text-align: center;
            margin: 15px auto;
        }

        .criteria {
            display: flex;
            justify-content: space-between;
            margin: 12px 0;
            padding: 0 5px;
        }

        .total {
            display: flex;
            justify-content: space-between;
            margin: 18px 0;
            padding: 0 25px;
            font-weight: bold;
        }

        .dates {
            display: flex;
            justify-content: space-between;
            margin: 18px 0;
            padding: 0 25px;
        }

        .avancement {
            border: 3px solid #333;
            padding: 20px;
            margin: 25px 0;
            max-width: 320px;
        }

        .notes-page-container {
            display: flex;
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
            margin: 35px 0;
        }

        .signature {
            text-align: center;
            margin: 25px 0;
        }

        .appreciation {
            margin: 18px 0;
        }

        .section-title {
            font-weight: bold;
            text-decoration: underline;
            text-align: center;
            margin: 18px 0;
        }

        .underline {
            display: inline-block;
            text-align: right;
            border-bottom: 1px solid #000;
            min-width: 120px;
        }

        ul {
            padding-left: 25px;
            margin: 15px 0;
        }

        li {
            margin: 8px 0;
        }

        strong {
            font-weight: bold;
        }

        .border-bottom {
            border-bottom: 2px solid #000;
            margin: 20px 0;
        }

        #releve-general-services-table * {
            font-size: 12px;
        }

        p {
            margin: 10px 0;
        }

        .cachet {
            color: #aa0000;
            font-style: italic;
            text-align: center;
            margin: 15px 0;
        }

        .notes-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin: 25px 0;
        }

        .notes-page {
            page-break-before: always;
            margin-top: 35px;
        }

        .devise {
            width: 25%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            align-items: center;
            font-size: 10pt;
        }

        .bracket-container-scalable {
            display: flex;
            align-items: center;
            position: relative;
            padding-left: 10px;
        }

        .bracket-scalable {
            font-size: 65px;
            line-height: 1;
            margin-right: 12px;
            font-weight: normal;
            font-family: monospace;
            left: 0;
            transform: translate(0, -50%);
            transform-origin: center;
            transition: transform 0.3s ease;
            z-index: 1;
            margin-top: 55px;
            top: 50%; 
        }

        .lines-scalable {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            margin-left: 23px;
        }
        .qrcode-wrapper {
            width: 150px;
            position:absolute;
            margin-top: -200px;
            margin-left: 0%;
            transform:translate(10px);

        }
         .notes {
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
            margin: 25px 0;        
            margin-left: 10%;     
        }

    </style>
</head>

<body>
    <!-- Page 1 -->
    <div class="page section">
        <div class="header">
            <div class="devise">
                <div>RÉPUBLIQUE DU BÉNIN</div>
                <div>------------------</div>
                <div>Fraternité-Justice-Travail</div>
            </div>
            <div class="notes">
                <div class="qrcode-wrapper" id="qrcode"  data-w="130px" data-h="auto"></div>
