<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ATTESTATION DE PRISE DE SERVICE
    </title>
    <style>
        @page {
            size: A4;
            margin: 0;
        }

        html, body {
            margin: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            background-color: #f5f5f5;
            font-size: 12pt;
            line-height: 2;
        }

        .page {
            width: 21cm;
            height: 29.7cm;
            padding: 1.5cm 2cm;
            margin: 0 auto;
            background: white;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            box-sizing: border-box;
            font-family: Arial, sans-serif;
            position: relative;
        }

        .container {
            width: 100%;
            height: 100%;
            position: relative;
        }

        .header {
            text-transform: uppercase;
            font-weight: bold;
            margin-bottom: 0.3cm;
        }

        .header h3 {
            margin: 0.2cm 0;
            font-size: 14px;
        }

        .center-content {
            text-align: center;
            margin-bottom: 0.3cm;
        }

        .center-content h4 {
            margin: 0.2cm 0;
            font-size: 13px;
        }

        .content {
            text-align: justify;
        }

        .signature {
            width: 100%;
            /* bottom: 2cm; */
            position: absolute;

            right: 50px;
            text-align: right;
            margin-top: 0;
        }

        .nom {
            margin-top: 1.5cm;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 0.5cm;
        }

        td {
            padding: 0.1cm 0.2cm;
            vertical-align: top;
        }

        .column-vu {
            text-align: left;
            padding-left: 0;
            width: 1.5cm;
        }

        .text-section p {
            margin: 0.2cm 0;
        }

        p {
            margin: 0.1cm 0;
        }

        .header p {
            margin: 0.1cm 0;
        }

        @media print {
            html, body {
                height: 29.7cm;
                width: 21cm;
                margin: 0;
                padding: 0;
                background-color: white;
                overflow: hidden;
            }

            .page {
                box-shadow: none;
                margin: 0;
                page-break-after: avoid;
            }

            body::after {
                content: "";
                display: none;
            }
        }

        .col-1 {
            width: 29%;
        }

        .col-2 {
            width: 1%;
        }

        .col-3 {
            width: 70%;
        }

    </style>
</head>
<body>
<div class="page">
    <div class="container">
        <div class="header">
            <img id="img-logo" src="mjl.png" alt="Logo MJL" style="text-align: left; padding-left: 0; width: 6cm;">
        </div>
        <div class="content">
            <table style="margin: 0; width: 100%; ">
                <tr>
                    <td style="width: 30%; text-align: end; vertical-align: middle;">
                        {{#ifEquals yes "yes"}}
                            <div class="" style="height: 100px; text-align: end; border: 2px solid black">
                                <div id="qrcode" data-w="auto" data-h="100%"></div>
                            </div>
                        {{else}}
                            <div class="" style="height: 100px; text-align: end;">
                                <div id="qrcode" data-w="auto" data-h="100%"></div>
                            </div>
                        {{/ifEquals}}
                        
                    </td>
                    <td style="margin: 0; width: 65%;  vertical-align: middle; font-weight: bold; font-size: 12pt;">
                        <div style="text-align: left;">
                            <p>
                                ATTESTATION DE PRISE DE SERVICE
                            </p>

                        </div>
                    </td>
                </tr>
            </table>
            <table style="margin: 0; width: 100%; vertical-align: top;">
                <tr style="margin: 0; vertical-align: top;">
                    <td style=" margin: 0; width: 1.7cm; vertical-align: top;">

                    </td>
                    <td style=" margin: 0; width: 3.1cm; vertical-align: top!important;">
                        <p style="font-size: 10px; text-align: center; vertical-align: text-top;margin-top: -10px;">
                            {{ orgNumero  }}</p>
                    </td>
                    <td style="margin: 0; vertical-align: top;">

                    </td>
                </tr>
            </table>
            <table>
                <tr>
                    <td class="column-vu"></td>
                    <td></td>
                </tr>
                <tr>
                    <!-- <td class="column-vu"></td>  -->
                    <td colspan="4" style="text-indent: 50px;padding-bottom: 3px;"><strong>Le Garde des Sceaux,
                        Ministre de la Justice et de la Législation,</strong></td>
                </tr>
                <tr style="line-height: .65cm;">
                    <!-- <td class="column-vu" style="text-align: end;font-weight: bold;"></td>  -->
                </td>
                <td colspan="4">Vu la demande en date de {{ date_demande }};
                </tr>

                <tr>
                    <td colspan="4">
                        <p style="text-align: center;"><strong>ATTESTE</strong> :</p>
                        <p style="line-height: cm;">
                            Que monsieur <strong>{{ first_name }} {{ last_name }}</strong>, {{ corps }}, grade <strong>{{ grade }}</strong>, numéro matricule <strong>{{ matricule }}</strong>, affecté par note de service n° <strong>{{ numero_note_service }}</strong> du <strong>{{ date_note_service }} </strong>,  a effectivement pris service le <strong>{{ date_of_service }}</strong> à la <strong>{{ structure }}</strong>.</p>
                        <p>
                            En foi de quoi, la présente attestation lui est délivrée  pour servir et valoir ce que de droit.
                        </p>
                    </td>
                </tr>
            </table>
        </div>
        <div class="signature">
            <p>Fait à Cotonou, le {{ date_signature }}</p>
            <p class="nom"><strong>P/Le Ministre et P.D <br> Le Directeurde Cabinet,</strong></p>
            {{#if signature}}
                <img src="{{signature}}" alt="Signature" style="max-height: 80px;">
            {{else}}
                <br><br>
            {{/if}}
            <p><strong>{{ signataire }}</strong></p>
        </div>
    </div>
</div>
<script>
    var imgUrlData = {

        photo: "data:image/png;base64,"
    }

    document.getElementById("img-logo").src = imgUrlData.photo

</script>
</body>
</html>